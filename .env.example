# Copy to .env and adjust. Docker Compose loads .env automatically.
# Do not commit .env.

# Same timezone as GENERIC_TIMEZONE (IANA name, e.g. America/Montevideo)
TZ=America/Montevideo
GENERIC_TIMEZONE=America/Montevideo

# Optional: 32+ character random string (openssl rand -hex 32)
# Strongly recommended if you ever recreate the volume without a backup.
N8N_ENCRYPTION_KEY=

# If you expose n8n on a hostname or HTTPS, set these to match the URL you use in the browser.
# Google OAuth redirect must match what n8n shows (e.g. http://localhost:5678/rest/oauth2-credential/callback).
N8N_HOST=localhost
N8N_PROTOCOL=http
